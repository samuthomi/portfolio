---
// A case study figure. Pass one image with src/width/height/alt,
// or several with images={[...]} (for the side-by-side "pair" variant).
// variant is a space-separated list of modifiers: framed, wide, pair, photos.
type Img = { src: string; width: number; height: number; alt: string };
interface Props extends Partial<Img> {
  images?: Img[];
  variant?: string;
  caption?: string;
}
const { images, variant, caption, src, width, height, alt } = Astro.props;
const list: Img[] = images ?? [{ src: src!, width: width!, height: height!, alt: alt! }];
const classes = ['cs-figure', ...(variant ? variant.split(/\s+/).map((v) => `cs-figure--${v}`) : [])].join(' ');
---
<figure class={classes}>
  {list.map((i) => <img src={i.src} width={i.width} height={i.height} loading="lazy" alt={i.alt}>)}
  {caption && <figcaption>{caption}</figcaption>}
</figure>
