---
import '../styles/global.css';
import Nav, { type NavVariant } from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  nav: NavVariant;
  noindex?: boolean;
  /** What shows when the page link is shared on LinkedIn, WhatsApp, Slack and similar. */
  preview?: {
    title?: string;
    description?: string;
    /** 1200x630 JPEG under /images/og/ */
    image?: string;
    imageAlt?: string;
    type?: 'website' | 'article';
  };
}
const { title, description, nav, noindex = false, preview = {} } = Astro.props;

// Extensionless public URL, matching how Cloudflare Pages serves each page.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/');
const pageUrl = new URL(path, Astro.site).href;
const previewImage = new URL(preview.image ?? '/images/og/home.jpg', Astro.site).href;
const previewAlt = preview.imageAlt ?? 'Samson Kirigua, Senior Product Designer';
---
<!doctype html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-NXT3K9KYGM"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-NXT3K9KYGM');
  </script>
  <meta charset="UTF-8">
  {noindex && <meta name="robots" content="noindex">}
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta property="og:site_name" content="Samson Kirigua">
  <meta property="og:title" content={preview.title ?? title}>
  <meta property="og:description" content={preview.description ?? description}>
  <meta property="og:url" content={pageUrl}>
  <meta property="og:type" content={preview.type ?? 'website'}>
  <meta property="og:image" content={previewImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={previewAlt}>
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200;0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,300;1,6..72,400&display=swap" rel="stylesheet">
  <link rel="preconnect" href="https://api.fontshare.com">
  <link rel="preconnect" href="https://api.fontshare.com" crossorigin>
  <link href="https://api.fontshare.com/v2/css?f[]=general-sans@200,300,400,500,600&display=swap" rel="stylesheet">
</head>
<body>
  <Nav variant={nav} />
  <slot />
  <Footer variant={nav} />
  <script>
    import '../scripts/nav';
  </script>
</body>
</html>
